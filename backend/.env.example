# Copy to backend/.env and fill in. Every setting is optional:
# without GROQ_API_KEY the app runs in demo mode (no LLM calls).

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# DATABASE_URL=sqlite:///recruitment.db
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# MAX_UPLOAD_MB=5

# Code sandbox (see SECURITY.md): "subprocess" (default) or "docker"
# CODE_EXECUTOR=subprocess
# CODE_TIMEOUT_SECONDS=5
# CODE_MEMORY_MB=256
